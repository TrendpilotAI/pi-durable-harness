+def cerebras_client(profile: ClientProfile) -> Any | None:
+    """Build an ``AsyncCerebras`` client, or ``None`` without a Cerebras key.
+
+    Only the Cerebras key is ever sent to Cerebras. ``warm_tcp_connection`` is
+    off because the SDK default opens a blocking sync connection inside the
+    constructor, which would stall the event loop on every chat turn.
+    """
+    key = settings.cerebras_api_key.get_secret_value()
+    if not key:
+        return None
+    from cerebras.cloud.sdk import AsyncCerebras
+
+    return AsyncCerebras(
+        api_key=key,
+        base_url=settings.cerebras_base_url,
+        timeout=profile.timeout,
+        max_retries=profile.max_retries,
+        warm_tcp_connection=False,
+    )
+
+
